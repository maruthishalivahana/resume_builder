PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resume_eng

# LaTeX Compiler Settings
LATEX_COMPILER=pdflatex
LATEX_COMPILE_TIMEOUT_MS=30000
LATEX_OUTPUT_DIR=storage/latex

# Semantic resume retrieval
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-v1
EMBEDDING_DIMENSIONS=64
ATLAS_VECTOR_INDEX_NAME=resume_evidence_vector
VECTOR_SEARCH_PROVIDER=mongo
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_SEMANTIC_WEIGHT=0.5

# Grounded LLM generation (backend only; never expose the key to the frontend)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000

# Optional development-only, local highlight selection. No cloud fallback.
# Set NODE_ENV=development and TAILORING_LLM_PROVIDER=ollama to opt in.
# TAILORING_LLM_PROVIDER overrides LLM_PROVIDER for structured JD tailoring only.
# TAILORING_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=30000
