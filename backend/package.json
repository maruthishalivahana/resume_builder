{
  "name": "resume_eng_backend",
  "version": "1.0.0",
  "description": "Backend API for RESUME.ENG LaTeX workspace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local-ai": "node start-local-ai.js",
    "test:local-ai": "node test-ollama-provider.js",
    "test:tailoring-quality": "node test-tailoring-quality.js",
    "test:negation": "node test-evidence-negation.js",
    "test:paraphrase": "node test-paraphrase-retrieval.js",
    "benchmark:tailoring": "node benchmarks/tailoring/run.js",
    "benchmark:tailoring:check": "node benchmarks/tailoring/run.js --check-baseline",
    "benchmark:tailoring:gate": "node benchmarks/tailoring/run.js --gate",
    "benchmark:local-model": "node benchmarks/tailoring/local-run.js",
    "verify:local-review": "node benchmarks/tailoring/local-review.js",
    "test:local-evaluation": "node test-local-evaluation.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node test-suite.js",
    "test:autosave": "node test-autosave.js && node test-autosave-recovery.js",
    "test:tree": "node test-tree-rename.js",
    "test:restoration": "node test-project-restoration.js",
    "test:file-tree": "node test-project-file-tree.js",
    "test:view-state": "node test-project-view-state.js",
    "test:entry": "node test-entry-compilation.js && node test-compile-target-ui.js && node test-pdf-preview.js",
    "test:pdf-preview": "node test-pdf-preview.js",
    "test:targets": "node test-compilation-targets.js",
    "test:capture": "node test-source-capture.js",
    "test:capture-live": "node test-source-capture-live.js",
    "test:tailoring": "npm run build && node test-tailoring.js",
    "test:semantic": "npm run build && node test-semantic.js",
    "test:hybrid": "npm run build && node test-hybrid.js",
    "test:match": "npm run build && node test-match.js",
    "test:grounded": "npm run build && node test-grounded.js",
    "test:openrouter-live": "npm run build && node test-openrouter-live.js",
    "test:source-patch": "npm run build && node test-source-patch.js"
    ,"test:m761": "npm run build && node test-m761-baseline.js && node test-match.js && node test-m761-regression.js"
    ,"test:m762": "npm run build && node test-m762-requirements.js"
    ,"test:m763": "npm run build && node test-m763-suggestions.js"
    ,"test:m8": "npm run build && node test-m8-requirements.js && node test-m761-regression.js"
    ,"test:generator": "npm run build && node test-generator.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
