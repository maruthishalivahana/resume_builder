{
  "name": "resume_eng_backend",
  "version": "1.0.0",
  "description": "Backend API for RESUME.ENG LaTeX workspace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node test-suite.js",
    "test:tailoring": "npm run build && node test-tailoring.js",
    "test:semantic": "npm run build && node test-semantic.js",
    "test:hybrid": "npm run build && node test-hybrid.js",
    "test:match": "npm run build && node test-match.js",
    "test:grounded": "npm run build && node test-grounded.js",
    "test:source-patch": "npm run build && node test-source-patch.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
